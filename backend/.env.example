# Server Port
PORT=5000

# MongoDB Connection URI
# For local MongoDB: mongodb://localhost:27017/travel-planner
# For MongoDB Atlas (cloud): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/travel-planner?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/travel-planner?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Hugging Face Inference API
# Get your free API key at: https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_api_key_here
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# CORS Origin (URL of your React frontend)
CLIENT_URL=http://localhost:3000
